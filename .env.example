
BOT_NAME=GondengBaileys

# Nomor internasional tanpa tanda +
OWNER_NUMBER=628xxxxxxxxxx

# Nomor untuk pairing code
PAIRING_NUMBER=628xxxxxxxxxx

# Opsional: JID WhatsApp Channel
# Contoh: xxxxxxxxx@newsletter
NEWSLETTER_JID=

# Folder penyimpanan sesi
AUTH_DIR=./auth_info

# Level: silent, fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Reconnect
RECONNECT_DELAY=3000
MAX_RECONNECT_ATTEMPTS=10
